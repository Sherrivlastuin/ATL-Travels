# ATL Travels - Production Environment Variables
# Copy these variables to Vercel Dashboard → Settings → Environment Variables
# Update the values with your actual production URLs and keys

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Backend API Configuration
NEXT_PUBLIC_API_URL=https://your-backend-api.com

# Environment
NODE_ENV=production

# Optional: Enable Vercel Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id_if_using_vercel_analytics
